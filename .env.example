NODE_ENV=development

POSTGRES_USER=samaya
POSTGRES_PASSWORD=samaya_dev_secret
POSTGRES_DB=samaya

REDIS_URL=redis://redis:6379

JWT_SECRET=please_change_me_in_production_with_a_64_byte_random_value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Внутренний токен для service-to-service вызовов whatsapp-service.
# В production обязательно заменить (сервисы откажутся стартовать с дефолтом).
WHATSAPP_INTERNAL_TOKEN=dev_internal_token

# WhatsApp: true — сообщения только пишутся в лог (безопасный дефолт),
# false — уходят реально через сессию WhatsApp Web (нужно привязать номер,
# QR в Настройки → Уведомления).
WHATSAPP_TEST_MODE=true

# Белый список получателей через запятую. Пока задан, сообщения уходят ТОЛЬКО
# на эти номера — остальные отклоняются с ошибкой `blocked by allowlist`.
# Обязателен на стенде с копией прод-базы: там реальные телефоны клиентов, и
# случайно запущенная рассылка ушла бы живым людям. На проде — пусто.
WHATSAPP_ALLOWLIST=

# Хост-порты Kong. По умолчанию 8010/8011, чтобы не конфликтовать с другими
# проектами на 8000/8001 (например, food-flow). Внутри сети kong всё равно слушает 8000.
KONG_PROXY_PORT=8010
KONG_ADMIN_PORT=8011

# Frontend (admin SPA на nginx). Открыть http://localhost:${FRONTEND_PORT}.
FRONTEND_PORT=3010

# Сид-компания (Самая) — детерминированный UUID, создаётся миграцией 001_users.sql.
DEFAULT_COMPANY_ID=00000000-0000-0000-0000-000000000001
DEFAULT_COMPANY_SLUG=samaya
LOG_LEVEL=info

# Телефония: ключ организации из портала ВАТС (Интеграции → «Ключи для страницы»).
# Даёт и журнал звонков, и записи разговоров. В браузер не отдаётся никогда —
# страница ходит только в telephony-service.
VATS_BASE_URL=https://vats05.ru/api/public
VATS_API_KEY=
# Как часто перечитывать журнал и на сколько дней назад уходить при первом старте.
TELEPHONY_SYNC_INTERVAL_MS=180000
TELEPHONY_SYNC_INITIAL_DAYS=90

# Выход в интернет для сервисов там, где у контейнеров нет прямого egress
# (iTTEST): мост слушает на адресе docker-шлюза и пересылает на прокси хоста.
# Оставьте пустым, если контейнеры ходят наружу сами.
EGRESS_BIND_HOST=
EGRESS_BIND_PORT=1180
EGRESS_TARGET_PORT=1080
VATS_PROXY_URL=
