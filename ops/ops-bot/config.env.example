# ─────────────────────────────────────────────────────────────
# Шаблон конфигурации агента управления.
#
# Боевой файл лежит ТОЛЬКО на сервере: /home/it/ops-bot/config.env
# с правами 600 и в git не попадает — внутри токен бота, который даёт
# полное управление контейнерами.
#
# Развернуть на новом сервере:
#   cp config.env.example /home/it/ops-bot/config.env
#   chmod 600 /home/it/ops-bot/config.env
#   # вписать токен и свой id, затем:
#   sudo cp samaya-ops-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now samaya-ops-bot
# ─────────────────────────────────────────────────────────────

# Токен бота. Получить у @BotFather: /newbot
# Обязательно ОТДЕЛЬНЫЙ бот, не тот, что шлёт уведомления из salon-service:
# очередь getUpdates одна на бота, два читателя воруют апдейты друг у друга.
TG_TOKEN=СЮДА_ТОКЕН

# Мост наружу. Прямого выхода в Telegram у сервера нет — весь трафик идёт
# через локальный xray. В /etc/environment он записан как socks5://, но это
# файл для сессий входа, systemd его не читает, да и стандартная библиотека
# Python socks5 не умеет: мост принимает обычный HTTP CONNECT.
# Пусто = ходить напрямую (если на сервере есть прямой доступ).
TG_PROXY=http://127.0.0.1:1080

# Владельцы — через запятую, Telegram user_id (узнать у @userinfobot).
# Только они раздают и снимают доступ; снять владельца командой нельзя,
# иначе можно разжаловать всех и остаться без доступа к боту.
TG_ADMINS=

# Что разрешено перезапускать и смотреть логи.
TG_ALLOWED=whatsapp-service,instagram-service,salon-service,frontend-service

# Что разрешено ОСТАНАВЛИВАТЬ. postgres и kong тут быть не должно:
# промах по кнопке с телефона не должен ронять всю систему.
TG_STOPPABLE=whatsapp-service,instagram-service
